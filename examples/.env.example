# =============================================================================
# Copy to .env next to your project and fill in. NEVER commit the real file.
#
# These variable names are what this kit's scripts and the reference
# implementation in examples/python/fallback_chain.py look for. If your project
# already reads different names, keep its names — don't create a second set.
#
# Every provider below speaks the OpenAI chat-completions wire format, so each
# one is just a base URL plus a key.
# =============================================================================

# --- OpenRouter ---------------------------------------------------------------
# openrouter.ai/settings/keys  (free, no card)
# Base URL: https://openrouter.ai/api/v1
#
# The free-tier daily cap is ACCOUNT-WIDE across every :free model. Chaining
# more :free models does not raise it — only another account or another
# provider does.
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME

# A second OpenRouter key is worth as much as a new provider IF it belongs to a
# different account. Same-account keys share one cap and gain nothing. Check
# with: GET https://openrouter.ai/api/v1/key -> data.creator_user_id
# OPENROUTER_API_KEY_2=sk-or-v1-REPLACE_ME

# --- Google AI Studio ---------------------------------------------------------
# aistudio.google.com/apikey  (free, no card)
# Base URL: https://generativelanguage.googleapis.com/v1beta/openai/
#
# Free tier meters PER PROJECT and PER MODEL per day — two different models on
# one key hold two separate allowances, which is genuinely worth exploiting.
GOOGLE_API_KEY=AIza-REPLACE_ME
# GEMINI_API_KEY=AIza-REPLACE_ME     # some tools read this name instead
# GOOGLE_API_KEY_2=AIza-REPLACE_ME   # only useful on a different account/project

# --- Groq ---------------------------------------------------------------------
# https://console.groq.com/keys  (free, no card)
# Base URL: https://api.groq.com/openai/v1
# Fast, generous free tier, independent of everything above.
GROQ_API_KEY=gsk_REPLACE_ME

# --- Cerebras -----------------------------------------------------------------
# https://cloud.cerebras.ai/
# Base URL: https://api.cerebras.ai/v1
# NOTE: a valid key can still return 402 Payment Required on every model if the
# account has no free-tier allowance active. Verify before adding to the chain.
# CEREBRAS_API_KEY=csk-REPLACE_ME

# --- NVIDIA NIM ---------------------------------------------------------------
# https://build.nvidia.com/
# Base URL: https://integrate.api.nvidia.com/v1
# NVIDIA_API_KEY=nvapi-REPLACE_ME

# =============================================================================
# Verify each one before it enters a chain:
#   python scripts/discover_free_models.py --provider groq
#   python scripts/discover_free_models.py --base-url <URL> --key-env <VAR>
# =============================================================================
